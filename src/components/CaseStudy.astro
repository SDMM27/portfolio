---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectDemo from './demos/ProjectDemo.astro';
import StatusBadge from './StatusBadge.astro';
import WipPanel from './WipPanel.astro';
import Chips from './Chips.astro';
import { useUi, homeUrl, projectUrl, type Lang } from '../i18n/ui';
import { getProjects, demoSlugs } from '../lib/projects';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const t = useUi(lang);
const p = t.project;
const projects = await getProjects(lang);
const idx = projects.findIndex((x) => x.slug === slug);
const project = projects[idx];
const { data } = project;
const { Content } = await render(project);
const prev = projects[(idx - 1 + projects.length) % projects.length];
const next = projects[(idx + 1) % projects.length];
const alternates = { fr: projectUrl('fr', slug), en: projectUrl('en', slug) };
const hasDemo = demoSlugs.includes(slug);
---
<Base lang={lang} title={`${data.title} — ${t.project.caseTitle} · Sacha Don`} description={data.tagline} alternates={alternates} type="article">
  <article class="mx-auto w-full max-w-4xl px-4 pb-16 pt-8 sm:px-6 md:pt-12">
    <a href={homeUrl(lang, '#projects')} class="inline-flex min-h-11 items-center gap-2 text-sm text-muted hover:text-ink"><span aria-hidden="true">←</span> {p.back}</a>

    <header class="mt-4">
      <div class="flex flex-wrap items-center gap-3">
        <StatusBadge lang={lang} status={data.status} />
        <span class="font-mono text-sm text-muted">{data.year}</span>
        {data.role && <span class="text-sm text-muted">· {data.role}</span>}
      </div>
      <h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">{data.title}</h1>
      <p class="mt-3 max-w-2xl text-xl leading-relaxed text-muted">{data.tagline}</p>
      <Chips items={data.stack} class="mt-5" />
      <div class="mt-6 flex flex-wrap gap-3">
        {data.links.live && (
          <a href={data.links.live} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center gap-2 rounded-xl bg-ink px-6 font-semibold text-bg transition-transform hover:-translate-y-0.5">{p.try} <span aria-hidden="true">↗</span></a>
        )}
        {data.links.repo ? (
          <a href={data.links.repo} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center gap-2 rounded-xl border border-line bg-surface px-6 font-semibold transition-colors hover:border-ink">{p.repo} <span aria-hidden="true">↗</span></a>
        ) : (
          <span class="inline-flex min-h-12 items-center rounded-xl border border-dashed border-line px-6 text-sm text-muted">{p.privateRepo}</span>
        )}
        {data.links.extra && (
          <a href={data.links.extra} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 items-center gap-2 rounded-xl border border-line bg-surface px-6 font-semibold transition-colors hover:border-ink">↗</a>
        )}
      </div>
      {slug === 'dailylingua' && <p class="mt-3 text-sm text-muted">{p.accountNote}</p>}
    </header>

    {hasDemo && <ProjectDemo slug={slug} class="mt-8 aspect-[16/10] w-full overflow-hidden rounded-card bg-surface-2" />}

    <section aria-label={p.highlights} class="mt-8">
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {data.highlights.map((h) => (
          <li class="rounded-xl border border-line bg-surface px-4 py-3 font-mono text-sm leading-snug">{h}</li>
        ))}
      </ul>
    </section>

    {data.status === 'wip' && <div class="mt-10"><WipPanel lang={lang} project={project} /></div>}

    <div class="prose-case mt-12">
      <Content />
    </div>

    <nav aria-label="Navigation" class="mt-16 grid grid-cols-1 gap-4 border-t border-line pt-8 sm:grid-cols-2">
      <a href={projectUrl(lang, prev.slug)} rel="prev" class="group flex min-h-20 flex-col justify-center rounded-card border border-line bg-surface px-5 py-4 transition-colors hover:border-accent">
        <span class="font-mono text-xs uppercase tracking-wider text-muted">← {p.prev}</span>
        <span class="mt-1 font-display text-lg font-bold">{prev.data.title}</span>
      </a>
      <a href={projectUrl(lang, next.slug)} rel="next" class="group flex min-h-20 flex-col justify-center rounded-card border border-line bg-surface px-5 py-4 text-right transition-colors hover:border-accent">
        <span class="font-mono text-xs uppercase tracking-wider text-muted">{p.following} →</span>
        <span class="mt-1 font-display text-lg font-bold">{next.data.title}</span>
      </a>
    </nav>
  </article>
</Base>
