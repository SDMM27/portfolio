---
interface Props { items: readonly string[]; class?: string }
const { items, class: className } = Astro.props;
---
<ul class:list={['flex flex-wrap gap-2', className]}>
  {items.map((s) => <li class="rounded-md border border-line bg-surface-2/60 px-2.5 py-1 font-mono text-xs text-muted">{s}</li>)}
</ul>
