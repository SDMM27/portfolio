---
interface Props { id: string; title: string; lead?: string }
const { id, title, lead } = Astro.props;
---
<section id={id} aria-labelledby={`${id}-title`} class="mx-auto w-full max-w-6xl scroll-mt-20 px-4 py-16 sm:px-6 md:py-24">
  <div class="reveal mb-8 max-w-2xl md:mb-12">
    <h2 id={`${id}-title`} class="font-display text-3xl font-extrabold tracking-tight sm:text-4xl">{title}</h2>
    {lead && <p class="mt-3 text-lg leading-relaxed text-muted">{lead}</p>}
  </div>
  <slot />
</section>
