---
// Live mini-demo for a project card or case-study header. Canvas-driven, lazy-loaded,
// paused offscreen, static under prefers-reduced-motion. Purely decorative for assistive tech.
interface Props {
  slug: string;
  class?: string;
}
const { slug, class: className } = Astro.props;
---

<div class:list={["demo-frame", className]} data-demo={slug} aria-hidden="true"></div>

<style>
  .demo-frame {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 200px;
    overflow: hidden;
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--ink) 9%, transparent) 1px, transparent 0) 0 0 / 18px 18px,
      var(--surface-2);
  }
</style>

<script>
  import { initDemos } from "../../scripts/demos/index";
  initDemos();
</script>
