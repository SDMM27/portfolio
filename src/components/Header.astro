---
import { useUi, homeUrl, type Lang } from '../i18n/ui';
import { otherLang, type Alternates } from '../lib/seo';

interface Props { lang: Lang; alternates: Alternates }
const { lang, alternates } = Astro.props;
const t = useUi(lang);
const other = otherLang(lang);
const links = (['projects', 'stack', 'path', 'contact'] as const).map((id) => ({
  href: homeUrl(lang, `#${id}`),
  label: t.nav[id]
}));
const btn =
  'inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg px-2.5 text-sm text-ink transition-colors hover:bg-surface-2';
---
<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur">
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center gap-1 px-4 sm:px-6">
    <a href={homeUrl(lang)} class="mr-auto inline-flex min-h-11 items-center font-display text-2xl font-extrabold tracking-tight" aria-label="Sacha Don">
      SD<span class="text-accent">.</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label={t.primaryNav}>
      {links.map((l) => <a href={l.href} class={btn}>{l.label}</a>)}
    </nav>

    <button type="button" data-palette-open class={`${btn} gap-2 font-mono text-xs`} aria-label={t.palette.open} aria-haspopup="dialog">
      <span data-mod-key>⌘K</span>
    </button>
    <a href={alternates[other]} hreflang={other} lang={other} class={`${btn} font-mono text-xs font-medium`} aria-label={t.langSwitch}>{t.langSwitchShort}</a>
    <button type="button" data-theme-toggle class={btn} aria-label={t.themeToggle}>
      <svg class="theme-moon size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      <svg class="theme-sun size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <button type="button" data-menu-button class={`${btn} md:hidden`} aria-expanded="false" aria-controls="mobile-nav" aria-label={t.menu}>
      <svg class="size-5" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
  <nav id="mobile-nav" hidden class="border-t border-line bg-bg md:hidden" aria-label={t.primaryNav}>
    <ul class="mx-auto flex max-w-6xl flex-col px-4 py-2 sm:px-6">
      {links.map((l) => (
        <li><a href={l.href} class="flex min-h-12 items-center border-b border-line/60 text-lg font-display font-semibold last:border-0">{l.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
