---
// Hero name rendered as interactive particles. The real <h1> stays in the DOM for SEO and
// screen readers, and remains visible until the canvas is ready (or if JS is off).
interface Props {
  text: string;
  class?: string;
}
const { text, class: className } = Astro.props;
---

<div class:list={["hero-particles", className]} data-hero-text={text}>
  <h1 class="hero-name">{text}</h1>
</div>

<style>
  .hero-particles {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 220px;
    display: grid;
    place-items: center;
    cursor: crosshair;
  }
  .hero-particles :global(canvas) {
    position: absolute;
    inset: 0;
  }
  .hero-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3.5rem, 15vw, 12rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: center;
    color: var(--ink);
    transition: opacity 0.4s;
  }
  .hero-particles.is-live .hero-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  import { mountHero } from "../scripts/hero-particles";
  document.querySelectorAll<HTMLElement>("[data-hero-text]").forEach((el) => {
    mountHero(el, el.dataset.heroText ?? "");
  });
</script>
