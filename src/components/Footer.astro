---
import { useUi, type Lang } from '../i18n/ui';
import { site } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useUi(lang);
---
<footer class="border-t border-line">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>© {new Date().getFullYear()} {site.name} · <a class="underline underline-offset-4 hover:text-ink" href={site.github} rel="noopener noreferrer">{site.handle}</a></p>
    <p>{t.footer.built}</p>
    <a href="#main" class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-ink">{t.footer.top}</a>
  </div>
</footer>
