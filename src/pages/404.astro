---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';

const alternates = { fr: '/fr/', en: '/en/' };
---
<Base lang="fr" title="404 — Sacha Don" description={ui.fr.notFound.text} alternates={alternates}>
  <section class="mx-auto flex min-h-[60vh] w-full max-w-3xl flex-col items-start justify-center gap-6 px-4 py-16 sm:px-6">
    <p class="font-mono text-sm text-muted">404</p>
    {(['fr', 'en'] as const).map((l) => (
      <div lang={l} data-nf={l}>
        {l === 'fr' ? <h1 class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl">{ui[l].notFound.title}</h1> : <p class="font-display text-2xl font-bold tracking-tight">{ui[l].notFound.title}</p>}
        <p class="mt-3 text-lg text-muted">{ui[l].notFound.text}</p>
        <a href={`/${l}/`} class="mt-5 inline-flex min-h-12 items-center rounded-xl bg-ink px-6 font-semibold text-bg">{ui[l].notFound.home} →</a>
      </div>
    ))}
  </section>
</Base>
